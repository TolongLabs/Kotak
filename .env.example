# Anthropic API key for server-side Claude requests.
ANTHROPIC_API_KEY=
# ElevenLabs API key for text-to-speech requests.
ELEVENLABS_API_KEY=
# ElevenLabs voice identifier for Kopi.
ELEVENLABS_VOICE_ID=
# Neon owner connection URL for the API, migrations and one-time runner setup.
DATABASE_URL=
# Local runner settings. scraper:worker reads its restricted database URL from .local/jobstreet-runner.json.
BROWSER_HEADLESS=false
# Optional saved browser-profile UUID.
BROWSER_PROFILE_ID=
JOBSTREET_DELAY_MS=30000
JOBSTREET_DELAY_JITTER_MS=30000
# Optional Clearcote build-cache override; the default is the platform's global cache.
CLEARCOTE_CACHE=
# RunPod API key for the batch endpoint.
RUNPOD_API_KEY=
# RunPod serverless endpoint identifier.
RUNPOD_ENDPOINT_ID=
# Cloudflare API token; Wrangler reads local secrets from .dev.vars.
CLOUDFLARE_API_TOKEN=
# Cloudflare account identifier.
CLOUDFLARE_ACCOUNT_ID=
