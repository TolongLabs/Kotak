# Anthropic API key for server-side Claude requests.
ANTHROPIC_API_KEY=
# ElevenLabs API key for text-to-speech requests.
ELEVENLABS_API_KEY=
# ElevenLabs voice identifier for Kopi.
ELEVENLABS_VOICE_ID=
# Neon pooled PostgreSQL connection URL.
DATABASE_URL=
# RunPod API key for the batch endpoint.
RUNPOD_API_KEY=
# RunPod serverless endpoint identifier.
RUNPOD_ENDPOINT_ID=
# Cloudflare API token; Wrangler reads local secrets from .dev.vars.
CLOUDFLARE_API_TOKEN=
# Cloudflare account identifier.
CLOUDFLARE_ACCOUNT_ID=
# Local Kameleo Engine. Start the installed Engine before running scrape:jobstreet.
KAMELEO_ENDPOINT=http://localhost:5050
