{
  "name": "kotak",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:data && bun run build:skill && bun run --parallel --filter './apps/*' dev",
    "build": "bun run build:data && bun run build:skill && bun run --filter @kotak/web build",
    "build:data": "bun scripts/build-data.ts",
    "build:skill": "bun scripts/build-skill.ts",
    "start": "bun apps/api/src/bun.ts",
    "db:seed": "bun apps/api/db/seed.ts",
    "db:migrate": "bun apps/api/db/migrate.ts",
    "admin:create": "bun scripts/admin-create.ts",
    "jobs:import": "bun apps/api/src/scrapers/jobstreet/import-cli.ts",
    "scraper:setup": "bun scripts/jobstreet-runner-setup.ts",
    "scraper:worker": "bun scripts/jobstreet-runner-start.ts",
    "tts:pregenerate": "bun scripts/tts-pregenerate.ts",
    "prewarm:ai": "bun scripts/prewarm-ai-cache.ts",
    "typecheck": "bun run --parallel --filter '*' typecheck && tsc --noEmit -p scripts",
    "test": "bun test",
    "ci:local": "act pull_request -j verify",
    "deploy:local": "act workflow_dispatch -W .github/workflows/deploy.yml --secret-file .secrets",
    "refresh:local": "act workflow_dispatch -W .github/workflows/refresh-data.yml --secret-file .secrets --artifact-server-path .artifacts",
    "ingest:onet": "bun scripts/ingest/onet.ts",
    "scrape:jobstreet": "bun apps/api/src/scrapers/jobstreet/cli.ts",
    "jobs:prepare": "bun apps/api/src/scrapers/jobstreet/prepare-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "graphify update .",
    "ingest:aei": "bun scripts/ingest/aei.ts",
    "ingest:dosm-jmi": "bun scripts/ingest/dosm-jmi.ts",
    "ingest:pathways": "bun scripts/ingest/pathways.ts",
    "ingest:sgf": "bun scripts/ingest/sgf.ts",
    "build:corner-groups": "bun scripts/corners/build-groups.ts",
    "batch:corners": "bun scripts/corners/run-batch.ts",
    "translate": "bun scripts/i18n/translate-roles.ts",
    "translate:roles": "bun scripts/i18n/translate-roles.ts 15-1252.00 15-2051.00 13-2011.00 13-1111.00 13-1071.00 11-2021.00 11-1021.00 11-1011.00 29-1141.00 25-2031.00",
    "refresh:check": "bun scripts/refresh/check.ts",
    "refresh:validate": "bun scripts/refresh/validate.ts",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky",
    "build:proofs": "bun scripts/proof-of-use/build.ts",
    "build:submission": "uv run scripts/submission/build.py"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.3",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
