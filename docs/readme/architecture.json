  "cards": [
    {
      "dot": "amber",
      "title": "Rules Decide",
      "items": [
        "The browser SDK sets verdicts, fit and roadmap steps from dated snapshots.",
        "Claude handles language and completion evidence; it does not set the rule outputs."
      ]
    },
    {
      "dot": "slate",
      "title": "Dated Data",
      "items": [
        "O*NET, the Anthropic Economic Index and DOSM provide the source data.",
        "SkillsFuture Singapore adds regional context; the links do not change verdicts."
      ]
    },
    {
      "dot": "slate",
      "title": "Deployment",
      "items": [
        "One Hono application serves Replit and Cloudflare Workers.",
        "The RunPod GPU drafts skills before deployment, not during each check-up."
      ]
    }
  ]
